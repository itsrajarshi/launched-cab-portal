# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase project settings (Dashboard -> Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=4000

# Auth — REQUIRED. Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# RabbitMQ (optional — defaults to amqp://localhost)
RABBITMQ_URL=amqp://localhost
RABBITMQ_BOOKING_QUEUE=booking_requests
